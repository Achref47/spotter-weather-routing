# Copy to .env (never commit .env). Values below are placeholders.
MAPBOX_TOKEN=your_mapbox_token_here
# Open-Meteo forecast model. Default ecmwf_ifs025; leave empty for Open-Meteo blended default.
OPEN_METEO_MODEL=ecmwf_ifs025

# Django (local development defaults; production values are set in Render, see docs/DEPLOYMENT.md)
DJANGO_DEBUG=true
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace_with_a_long_random_value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional
# NUM_PROXIES=0
# ANALYZE_RATE_BURST=10/min
# ANALYZE_RATE_HOUR=30/hour
# NOMINATIM_USER_AGENT=
